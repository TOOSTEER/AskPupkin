// AJAX обработка лайков
document.addEventListener('DOMContentLoaded', function() {
    // Обработка лайков вопросов
    document.querySelectorAll('.question-like-btn').forEach(button => {
        button.addEventListener('click', function() {
            const questionId = this.dataset.questionId;
            const value = this.dataset.value;
            const counter = document.querySelector(`#question-rating-${questionId}`);
            
            sendLikeRequest(`/question/${questionId}/like/`, value, counter, 'question');
        });
    });
    
    // Обработка лайков ответов
    document.querySelectorAll('.answer-like-btn').forEach(button => {
        button.addEventListener('click', function() {
            const answerId = this.dataset.answerId;
            const value = this.dataset.value;
            const counter = document.querySelector(`#answer-rating-${answerId}`);
            
            sendLikeRequest(`/answer/${answerId}/like/`, value, counter, 'answer');
        });
    });
    
    function sendLikeRequest(url, value, counter, type) {
        fetch(url, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRFToken': getCookie('csrftoken')
            },
            body: JSON.stringify({ value: parseInt(value) })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                if (counter) {
                    counter.textContent = data.new_rating;
                }
                updateButtonStates(type, data.new_rating);
            } else {
                if (data.redirect) {
                    window.location.href = data.redirect;
                } else {
                    alert(data.error || 'Произошла ошибка');
                }
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Произошла ошибка при отправке запроса');
        });
    }
    
    function updateButtonStates(type, newRating) {
        // Обновляем состояния кнопок (активные/неактивные)
        // В реальном проекте здесь будет логика обновления UI
        console.log(`${type} rating updated to ${newRating}`);
    }
    
    function getCookie(name) {
        let cookieValue = null;
        if (document.cookie && document.cookie !== '') {
            const cookies = document.cookie.split(';');
            for (let i = 0; i < cookies.length; i++) {
                const cookie = cookies[i].trim();
                if (cookie.substring(0, name.length + 1) === (name + '=')) {
                    cookieValue = decodeURIComponent(cookie.substring(name.length + 1));
                    break;
                }
            }
        }
        return cookieValue;
    }
});